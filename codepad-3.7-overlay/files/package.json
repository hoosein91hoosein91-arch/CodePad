    "preview:mobile": "node scripts/serve-mobile.mjs --port 8081",
    "test:source": "node --test scripts/hub.test.mjs scripts/hub-ctf.test.mjs scripts/hub-forensics.test.mjs scripts/security-lab.test.mjs scripts/security-share.test.mjs scripts/security-netcheck.test.mjs scripts/desktop-system.test.mjs scripts/music.test.mjs scripts/python-routing.test.mjs scripts/python-routing-reachability.test.mjs scripts/run-config.test.mjs scripts/python-host.test.mjs scripts/ai-provider.test.mjs scripts/device-tools.test.mjs scripts/mobile-source.test.mjs scripts/nava-models.test.mjs scripts/nava-physics.test.mjs",
    "test:continuous:node": "node scripts/continuous-runtime-node-test.mjs",
    "dev:react": "node scripts/with-app-env.mjs vite dev --host 0.0.0.0 --port 8080",
    "test:upgrade": "node scripts/upgrade-browser-test.mjs && node scripts/nava-graphics-browser-test.mjs",
    "test:android-export": "node scripts/android-export-test.mjs",
    "test:vision": "node scripts/test-vision.mjs",
    "android:preview": "node scripts/prepare-vision-preview.mjs",
    "test:airpaint": "node scripts/test-airpaint.mjs",
    "test:vision:kernels": "node scripts/test-vision-kernels.mjs",
    "benchmark:vision": "node scripts/benchmark-vision.mjs",
    "test:hand-accuracy": "node scripts/test-hand-accuracy.mjs",
    "test:hand-validation": "node --test scripts/hand-camera.test.mjs scripts/hand-validation.test.mjs",
    "test:turtle": "node scripts/test-turtle.mjs",
    "test:studio:core": "node --test scripts/studio-core.test.mjs",
    "test:studio:browser": "node scripts/run-local-qa.mjs scripts/studio-browser-test.mjs",
    "test:studio:camera": "node scripts/run-local-qa.mjs scripts/studio-camera-test.mjs",
    "test:vision:layout": "node scripts/run-local-qa.mjs scripts/vision-layout-test.mjs",
    "test:project:zip": "node --test scripts/project-zip.test.mjs",
    "test:project:browser": "node scripts/run-local-qa.mjs scripts/project-zip-browser-test.mjs",
    "test:portal:opencv": "node scripts/run-local-qa.mjs scripts/test-portal-opencv.mjs",
    "test:termux:project": "node --test scripts/termux-project.test.mjs",
    "test:runtime:ux": "node scripts/run-local-qa.mjs scripts/runtime-ux-test.mjs",
    "test:apk:layout": "python3 scripts/apk-layout.test.py",
    "test:apk:worker": "node scripts/run-local-qa.mjs scripts/test-apk-worker.mjs"
