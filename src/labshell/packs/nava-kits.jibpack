@@@ jibpack 1 نوا: ابزارهای آماده (مخفف)
@@@ file main.nava
# نوا ۰٫۴: هر ابزار آماده فقط یک خط است — مخفف‌ها و دستورهای کامل با هم کار می‌کنند
pg "جعبه‌ابزار من"
fg #67f5a5
tx "ماشین‌حساب، تایمر و شمارنده — هر کدام یک خط"
cal mb
tm ۶۰
cnt
# دکمه با کپسول ظاهر: پهنا ۲۴۰، بلندی ۶۴، دو رنگ از پالت
num امتیاز = ۰
out "امتیاز: {امتیاز}"
bt "یک امتیاز" (ru240rn64yN24D08): امتیاز += ۱
bt "پیام" (ru240rn64yGi65G72): sy "آفرین! 🎉"
# بستهٔ قابل‌استفادهٔ دوباره: df … end و us
df "جایزه"
bt "جایزه ۱۰تایی"
  اگر امتیاز >= ۵
    امتیاز += ۱۰
    پیام "جایزه گرفتی!"
  وگرنه
    پیام "اول ۵ امتیاز بگیر"
  end
end
end
us "جایزه"
