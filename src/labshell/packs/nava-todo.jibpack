@@@ jibpack 1 نوا: کارهای من
@@@ file main.nava
# فهرست کارها — با ذخیرهٔ خودکار
برنامه "کارهای من"
رنگ #67f5a5
لیست کارها
عدد انجام‌شده = ۰
ذخیره کارها، انجام‌شده

عنوان "📝 کارهای امروز"
ورودی کار "یک کار تازه بنویس…"
ردیف
  دکمه "➕ افزودن": اجرا افزودن‌کار
  دکمه "✓ اولی انجام شد": اجرا انجام
پایان
نمایش "{طول(کارها)} کار مانده · {انجام‌شده} کار انجام شده"
نمایش "🎉 همه را انجام دادی!" اگر طول(کارها) = ۰ و انجام‌شده > ۰
فهرست کارها با حذف
دکمه "پاک کردن همه": خالی کارها؛ انجام‌شده = ۰

کنش افزودن‌کار
  اگر کار = ""
    پیام "اول چیزی بنویس ✍️"
    برگرد
  پایان
  اگر شامل(کارها، کار)
    پیام "این کار را قبلاً نوشته‌ای"
  وگرنه
    افزودن کار به کارها
    صدا ۶۶۰، ۸۰
  پایان
  کار = ""
پایان

کنش انجام
  اگر طول(کارها) > ۰
    حذف اول از کارها
    انجام‌شده += ۱
    آهنگ ۵۲۳، ۶۵۹، ۷۸۴
  پایان
پایان
