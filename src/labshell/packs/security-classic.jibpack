@@@ jibpack 1 رمز سزار و ویژنر 🗝️
@@@ file main.py
# رمزهای کلاسیک: سزار و ویژنر — و اینکه چرا امروز امن نیستند
from collections import Counter

ABC = "abcdefghijklmnopqrstuvwxyz"

def caesar(text, shift):
    out = []
    for ch in text:
        low = ch.lower()
        if low in ABC:
            c = ABC[(ABC.index(low) + shift) % 26]
            out.append(c.upper() if ch.isupper() else c)
        else:
            out.append(ch)
    return "".join(out)

def vigenere(text, key, decrypt=False):
    out, i = [], 0
    for ch in text:
        low = ch.lower()
        if low in ABC:
            k = ABC.index(key[i % len(key)].lower()) * (-1 if decrypt else 1)
            c = ABC[(ABC.index(low) + k) % 26]
            out.append(c.upper() if ch.isupper() else c)
            i += 1
        else:
            out.append(ch)
    return "".join(out)

msg = "Meet me at the library at seven"
enc = caesar(msg, 3)
print("سزار (جابه‌جایی ۳):", enc)
print("رمزگشایی        :", caesar(enc, -3))

# حمله با امتحان همهٔ ۲۵ کلید (brute force) — فقط ۲۵ حالت دارد!
print("\nامتحان همهٔ کلیدها روی پیام رمزشده:")
common = {"the", "at", "me", "and", "is"}
for s in range(1, 26):
    guess = caesar(enc, -s)
    score = sum(w in common for w in guess.lower().split())
    if score >= 2:
        print(f"  کلید {s:2}: {guess}   ← احتمالاً همین!")

# تحلیل فراوانی: در انگلیسی حرف e از همه رایج‌تر است
long = caesar("the quick brown fox jumps over the lazy dog and then sleeps every evening near the tree", 7)
top = Counter(c for c in long if c in ABC).most_common(1)[0][0]
guess_shift = (ABC.index(top) - ABC.index("e")) % 26
print("\nتحلیل فراوانی: رایج‌ترین حرف =", top, "→ کلید حدسی =", guess_shift)

v = vigenere(msg, "KEY")
print("\nویژنر (کلید KEY):", v)
print("رمزگشایی        :", vigenere(v, "KEY", decrypt=True))
print("\nنکته: ویژنر هم با روش کاسیسکی/فراوانی شکسته می‌شود. رمزنگاری امروزی AES و ChaCha20 است.")
