@@@ file main.py
# کدگذاری Base64 و Hex — کدگذاری «رمزنگاری» نیست! هر کسی می‌تواند برش گرداند.
import base64, binascii, urllib.parse

text = "سلام دنیا! Hello 123"
raw = text.encode("utf-8")
print("متن      :", text)
print("بایت‌ها   :", list(raw[:12]), "…")

b64 = base64.b64encode(raw).decode()
print("\nBase64   :", b64)
print("برگشت    :", base64.b64decode(b64).decode("utf-8"))
print("URL-safe :", base64.urlsafe_b64encode(raw).decode())

hx = raw.hex()
print("\nHex      :", hx)
print("برگشت    :", bytes.fromhex(hx).decode("utf-8"))
print("binascii :", binascii.hexlify(b"AB").decode(), "→", binascii.unhexlify("4142").decode())

print("\nدرصدکدگذاری URL:", urllib.parse.quote(text))
print("برگشت          :", urllib.parse.unquote(urllib.parse.quote(text)))

bits = " ".join(f"{b:08b}" for b in "Hi".encode())
print("\nدودویی 'Hi':", bits)

# Base64 هر ۳ بایت را به ۴ نویسه تبدیل می‌کند؛ پس حدود ۳۳٪ بزرگ‌تر می‌شود
print(f"\nاندازه: {len(raw)} بایت → {len(b64)} نویسهٔ Base64")
