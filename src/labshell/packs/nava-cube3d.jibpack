@@@ jibpack 1 نوا: سه‌بعدی
@@@ file main.nava
// Nava sample
Ap "سه‌بعدی نوا"
Fg #59d7ff
Bg #05070d
Hd "🧊 صحنهٔ سه‌بعدی"
Sc N320, N300
Cu V1 "#67f5a5"
Sp V2 "#ff85aa" Pos N1d8, N0, N0
Pyramid V3 "#ffc56b" Pos -N1d8, N0, N0
Floor V4 "#16304a" Pos N0, -N1d2, N0
Num V5 = N2
Out "سرعت چرخش: {V5}"
Row
  Bt "کندتر": V5 = Max(N0, V5 - N1)
  Bt "تندتر": V5 += N1
End
Tx "روی صحنه بزن تا دوربین جلو و عقب برود."
Num V6 = N6
Every N0d03 Sec
  Rt V1 V5, V5 * N1d5, N0
  Rt V3 N0, V5 * N2, N0
  Ps V2 N1d8, Sin(Time() * N180) * N0d6, N0
End
Touch
  V6 += N2
  If V6 > N10: V6 = N4
  Cm V6
End
