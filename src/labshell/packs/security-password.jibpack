@@@ jibpack 1 سنجش قدرت رمز 🛡️
@@@ file index.html
<!doctype html>
<html lang="fa" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>سنجش قدرت رمز عبور</title>
<style>
  body{margin:0;min-height:100vh;background:#020805;color:#d6ffe9;font-family:system-ui,Tahoma,sans-serif;padding:20px;box-sizing:border-box}
  h1{font:600 1.2rem ui-monospace,monospace;color:#00ff9c;text-shadow:0 0 12px #00ff9c88;margin:0 0 14px}
  input{width:100%;box-sizing:border-box;padding:14px;border-radius:14px;border:1px solid #00ff9c55;background:#000;color:#00ff9c;font:1.05rem ui-monospace,monospace;direction:ltr}
  .bar{height:10px;border-radius:9px;background:#0e2318;margin:14px 0 6px;overflow:hidden}
  .fill{height:100%;width:0;transition:width .25s,background .25s}
  .card{border:1px solid #00ff9c33;border-radius:16px;padding:12px 14px;margin-top:12px;background:#03140b}
  li{margin:4px 0;font-size:.9rem}
  .ok{color:#00ff9c}.no{color:#ff6b8b}
  button{margin-top:12px;width:100%;padding:13px;border:0;border-radius:14px;background:#00ff9c;color:#001a0c;font-weight:700;font-size:1rem}
  code{font-family:ui-monospace,monospace;color:#9effd0}
</style>
</head>
<body>
<h1>&gt; password_strength</h1>
<input id="pw" placeholder="یک رمز عبور بنویس…" autocomplete="off" spellcheck="false">
<div class="bar"><div class="fill" id="fill"></div></div>
<div id="label">—</div>
<div class="card">
  <div>آنتروپی تقریبی: <code id="bits">0</code> بیت</div>
  <div>زمان حدس (۱۰ میلیارد حدس در ثانیه): <code id="time">—</code></div>
  <ul id="checks"></ul>
</div>
<button id="gen">ساخت رمز تصادفی امن</button>
<div class="card" style="font-size:.85rem;line-height:1.7">
  آنتروپی = طول × log2(اندازهٔ مجموعهٔ نویسه‌ها). رمز طولانی‌تر بیشتر از نویسه‌های عجیب کمک می‌کند.
  رمز فقط در همین صفحه بررسی می‌شود و به هیچ‌جا فرستاده نمی‌شود.
</div>
<script>
const COMMON = ["123456","password","qwerty","111111","123456789","abc123","iloveyou","admin","welcome","000000"];
const pw = document.getElementById("pw");
function pool(s){let p=0;if(/[a-z]/.test(s))p+=26;if(/[A-Z]/.test(s))p+=26;if(/[0-9]/.test(s))p+=10;if(/[^a-zA-Z0-9]/.test(s))p+=33;return p}
function human(sec){const u=[["سال",31536000],["روز",86400],["ساعت",3600],["دقیقه",60],["ثانیه",1]];if(sec<1)return "فوری";if(sec>31536000*1e9)return "بیش از میلیاردها سال";for(const [n,v] of u)if(sec>=v)return Math.round(sec/v).toLocaleString("fa-IR")+" "+n;return "فوری"}
function update(){
  const s = pw.value, p = pool(s);
  let bits = s.length && p ? s.length*Math.log2(p) : 0;
  const common = COMMON.includes(s.toLowerCase());
  if (common) bits = Math.min(bits, 10);
  if (/^(.)\1+$/.test(s)) bits = Math.min(bits, 8);
  const pct = Math.min(100, bits/1.2);
  const [txt,col] = bits<28?["خیلی ضعیف","#ff3d6e"]:bits<40?["ضعیف","#ff8a3d"]:bits<60?["متوسط","#ffd23d"]:bits<80?["خوب","#9dff5c"]:["قوی","#00ff9c"];
  document.getElementById("fill").style.width = pct+"%";
  document.getElementById("fill").style.background = col;
  document.getElementById("label").textContent = s ? txt : "—";
  document.getElementById("label").style.color = col;
  document.getElementById("bits").textContent = Math.round(bits);
  document.getElementById("time").textContent = s ? human(Math.pow(2,bits)/2/1e10) : "—";
  const checks = [[s.length>=12,"حداقل ۱۲ نویسه"],[/[a-z]/.test(s)&&/[A-Z]/.test(s),"حروف کوچک و بزرگ"],[/[0-9]/.test(s),"عدد"],[/[^a-zA-Z0-9]/.test(s),"نماد"],[!common,"جزو رمزهای رایج نیست"]];
  document.getElementById("checks").innerHTML = checks.map(([ok,t])=>`<li class="${ok?"ok":"no"}">${ok?"✓":"✗"} ${t}</li>`).join("");
}
document.getElementById("gen").onclick = () => {
  const chars = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789!@#$%^&*-_=+?";
  const r = new Uint32Array(18); crypto.getRandomValues(r);
  pw.value = [...r].map(v => chars[v % chars.length]).join("");
  update();
  if (window.jibos) jibos.beep(990, 90);
};
pw.addEventListener("input", update);
update();
</script>
</body>
</html>
