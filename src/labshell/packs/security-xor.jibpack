@@@ jibpack 1 رمز XOR ⊕
@@@ file main.py
# رمز XOR — پایهٔ بسیاری از رمزهای جریانی، و خطر استفادهٔ دوباره از کلید
def xor_bytes(data: bytes, key: bytes) -> bytes:
    return bytes(b ^ key[i % len(key)] for i, b in enumerate(data))

key = b"K3y"
plain = "پیام محرمانه: ساعت ۸".encode("utf-8")
cipher = xor_bytes(plain, key)
print("متن     :", plain.decode())
print("رمزشده  :", cipher.hex())
print("رمزگشایی:", xor_bytes(cipher, key).decode())

print("\nویژگی‌های XOR:")
print("  A ^ A = 0      →", 0b1010 ^ 0b1010)
print("  A ^ 0 = A      →", bin(0b1010 ^ 0))
print("  (A ^ K) ^ K = A →", (0b1010 ^ 0b0110) ^ 0b0110 == 0b1010)

# ضعف: اگر بخشی از متن را بدانیم (known plaintext)، کلید لو می‌رود
known = "پیام".encode("utf-8")[: len(key)]
leaked = xor_bytes(cipher[: len(key)], known)
print("\nحملهٔ متن معلوم: با دانستن شروع پیام، کلید =", leaked, "→ درست است؟", leaked == key)

# ضعف: دو پیام با یک کلید → XOR دو رمز = XOR دو متن (کلید حذف می‌شود)
m1, m2 = b"attack at dawn", b"defend at dusk"
c1, c2 = xor_bytes(m1, b"secretkey12345"), xor_bytes(m2, b"secretkey12345")
print("c1 ^ c2 == m1 ^ m2 ؟", xor_bytes(c1, c2) == xor_bytes(m1, m2))
print("\nنتیجه: XOR فقط وقتی امن است که کلید تصادفی، هم‌طول پیام و یک‌بارمصرف باشد (One-Time Pad).")
