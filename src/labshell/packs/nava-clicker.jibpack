@@@ jibpack 1 نوا: معدن طلا
@@@ file main.nava
// Nava sample
Ap "معدن طلا"
Fg #ffc56b
Bg #140f05
Num V1 = N0
Num V2 = N1
Num V3 = N0
Num V4 = N0
Store V1, V2, V3, V4

Hd "⛏️ معدن طلا"
Out "💰 {Round(V1)} طلا"
Out "هر کلیک {V2} · {V3} کارگر (هر ثانیه {V3 * N2})"
Bt "⛏️ بکن!"
  V1 += V2
  Tone N880, N40
End
Row
  Bt "کلنگ بهتر": Do V5 "کلنگ"
  Bt "کارگر تازه": Do V5 "کارگر"
End
Out "قیمت کلنگ: {V6(V2)} · قیمت کارگر: {V6(V3 + N2)}"
Out "🏆 رکورد: {Round(V4)}"
Bt "از اول": V1 = N0; V2 = N1; V3 = N0

Fn V6 With V7
  Ret Round(N10 * Pow(N1d6, V7))
End

Act V5 With V8
  Var V9 = V6(V2)
  If V8 = "کارگر": V9 = V6(V3 + N2)
  If V1 < V9
    Msg "{V9 - Round(V1)} طلای دیگر لازم داری"
    Return
  End
  V1 -= V9
  If V8 = "کلنگ": V2 += N1
  If V8 = "کارگر": V3 += N1
  Melody N523, N659, N784
End

Every N1 Sec
  V1 += V3 * N2
  V4 = Max(V4, V1)
End
