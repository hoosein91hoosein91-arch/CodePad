@@@ jibpack 1 اسکن پورت (nmap، آموزشی)
@@@ file main.py
# «اسکن پورت» چگونه کار می‌کند — توضیح مفهومی + شبیه‌سازی آفلاین
# هشدار صادقانه: این برنامه هیچ بسته‌ای روی شبکهٔ واقعی نمی‌فرستد و هیچ سوکت
# واقعی باز نمی‌کند. WebView/مرورگر به سوکت خام TCP/UDP دسترسی ندارد، پس اسکن
# واقعی مثل nmap از داخل این برنامه ممکن نیست. همهٔ نتایج از دادهٔ ساختگیِ قطعی
# ساخته می‌شوند تا فقط «مفهوم» را یاد بگیری. اسکن شبکهٔ دیگران بدون اجازه هم
# در بسیاری جاها غیرقانونی است.

COMMON = {
    21: "ftp", 22: "ssh", 23: "telnet", 25: "smtp", 53: "domain",
    80: "http", 110: "pop3", 143: "imap", 443: "https", 3306: "mysql",
    3389: "rdp", 5432: "postgresql", 6379: "redis", 8080: "http-proxy",
}

print("اسکن پورت یعنی چه؟")
print("- هر سرویس شبکه روی یک «پورت» (شماره ۰ تا ۶۵۵۳۵) گوش می‌دهد.")
print("- اسکنر تلاش می‌کند به هر پورت وصل شود تا ببیند باز/بسته/فیلترشده است:")
print("    open     = سرویسی پاسخ داد (SYN→SYN/ACK در TCP)")
print("    closed   = پورت پاسخ رد داد (RST)")
print("    filtered = فایروال جلوی پاسخ را گرفت (چیزی برنگشت)")
print("- nmap واقعی انواع اسکن دارد: -sS (نیمه‌باز)، -sT (اتصال کامل)، -sn (کشف میزبان).")
print()

def mock_scan(host: str):
    # هش سادهٔ قطعی تا برای یک «میزبان» همیشه همان نتیجه بیاید (ساختگی!)
    h = 2166136261
    for ch in host:
        h = ((h ^ ord(ch)) * 16777619) & 0xFFFFFFFF
    out = []
    for i, (port, svc) in enumerate(sorted(COMMON.items())):
        r = (h >> (i % 24)) & 0x7
        state = "open" if r == 0 else "filtered" if r == 1 else "closed"
        out.append((port, state, svc))
    return out

host = "192.168.1.10"  # عوضش کن تا خروجی ساختگیِ متفاوت ببینی
print(f"NMAP-SIM (شبیه‌سازی‌شده) — گزارش برای {host}")
print(f"{'PORT':<8}{'STATE':<10}SERVICE")
open_count = 0
for port, state, svc in mock_scan(host):
    if state == "closed":
        continue
    open_count += state == "open"
    print(f"{port:<8}{state:<10}{svc}")
print(f"\nتمام شد (ساختگی): {open_count} پورت باز. هیچ ترافیک واقعی ارسال نشد.")
print("برای اسکن واقعی باید nmap را در Termux/لینوکس و فقط روی شبکهٔ خودت اجرا کنی.")
