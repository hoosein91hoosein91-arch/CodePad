# دستیار هوشمند با Gemini (کلید خودت در «اتصال Gemini» لانچر)
برنامه "دستیار نوا"
رنگ #c5a2ff
عنوان "🤖 از هوش مصنوعی بپرس"
ورودی سوال "سوالت را بنویس…" چندخطی
متغیر جواب = ""
لیست تاریخچه
ردیف
  دکمه "بپرس": اجرا پرسیدن سوال
  دکمه "یک ایده بده": اجرا پرسیدن "یک ایدهٔ کوتاه برای یک برنامهٔ موبایل ساده بگو"
پایان
نمایش جواب
فهرست تاریخچه با حذف

کنش پرسیدن با متن‌سوال
  اگر متن‌سوال = "": پیام "اول سوالت را بنویس"؛ برگرد
  بپرس جواب = متن‌سوال
  افزودن متن‌سوال به اول تاریخچه
پایان
