@@@ jibpack 1 نوا: سه‌بعدی
@@@ file main.nava
# سه‌بعدی با WebGL: شکل بساز، بچرخان، جابه‌جا کن — بدون یک خط کد گرافیکی
برنامه "سه‌بعدی نوا"
رنگ #59d7ff
پس‌زمینه #05070d
عنوان "🧊 صحنهٔ سه‌بعدی"
صحنه ۳۲۰، ۳۰۰
مکعب جعبه "#67f5a5"
کره توپ "#ff85aa" در ۱.۸، ۰، ۰
هرم کوه "#ffc56b" در -۱.۸، ۰، ۰
زمین کف "#16304a" در ۰، -۱.۲، ۰
عدد سرعت = ۲
نمایش "سرعت چرخش: {سرعت}"
ردیف
  دکمه "کندتر": سرعت = حداکثر(۰، سرعت - ۱)
  دکمه "تندتر": سرعت += ۱
پایان
متن "روی صحنه بزن تا دوربین جلو و عقب برود."
عدد فاصله‌دوربین = ۶
هر ۰.۰۳ ثانیه
  بچرخان جعبه سرعت، سرعت * ۱.۵، ۰
  بچرخان کوه ۰، سرعت * ۲، ۰
  جابجا توپ ۱.۸، سینوس(زمان() * ۱۸۰) * ۰.۶، ۰
پایان
وقتی لمس
  فاصله‌دوربین += ۲
  اگر فاصله‌دوربین > ۱۰: فاصله‌دوربین = ۴
  دوربین فاصله‌دوربین
پایان
