@@@ jibpack 1 نوا: معدن طلا
@@@ file main.nava
# بازی کلیکی: طلا جمع کن، ارتقا بخر؛ کارگرها حتی وقتی بیکاری طلا می‌آورند
برنامه "معدن طلا"
رنگ #ffc56b
پس‌زمینه #140f05
عدد طلا = ۰
عدد قدرت = ۱
عدد کارگر = ۰
عدد رکورد = ۰
ذخیره طلا، قدرت، کارگر، رکورد

عنوان "⛏️ معدن طلا"
نمایش "💰 {گرد(طلا)} طلا"
نمایش "هر کلیک {قدرت} · {کارگر} کارگر (هر ثانیه {کارگر * ۲})"
دکمه "⛏️ بکن!"
  طلا += قدرت
  صدا ۸۸۰، ۴۰
پایان
ردیف
  دکمه "کلنگ بهتر": اجرا خرید "کلنگ"
  دکمه "کارگر تازه": اجرا خرید "کارگر"
پایان
نمایش "قیمت کلنگ: {قیمت(قدرت)} · قیمت کارگر: {قیمت(کارگر + ۲)}"
نمایش "🏆 رکورد: {گرد(رکورد)}"
دکمه "از اول": طلا = ۰؛ قدرت = ۱؛ کارگر = ۰

تابع قیمت با سطح
  نتیجه گرد(۱۰ * توان(۱.۶، سطح))
پایان

کنش خرید با چیز
  متغیر هزینه = قیمت(قدرت)
  اگر چیز = "کارگر": هزینه = قیمت(کارگر + ۲)
  اگر طلا < هزینه
    پیام "{هزینه - گرد(طلا)} طلای دیگر لازم داری"
    برگرد
  پایان
  طلا -= هزینه
  اگر چیز = "کلنگ": قدرت += ۱
  اگر چیز = "کارگر": کارگر += ۱
  آهنگ ۵۲۳، ۶۵۹، ۷۸۴
پایان

هر ۱ ثانیه
  طلا += کارگر * ۲
  رکورد = حداکثر(رکورد، طلا)
پایان
