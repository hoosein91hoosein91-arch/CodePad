@@@ jibpack 1 نوا: مار
@@@ file main.nava
# بازی مار روی بوم: با کشیدن انگشت روی بوم یا کلیدهای جهت بازی کن
برنامه "مار نوا"
رنگ #67f5a5
پس‌زمینه #050b08
بوم ۳۲۰، ۳۲۰
لیست مار = [[۸، ۸]، [۷، ۸]، [۶، ۸]]
متغیر سو = [۱، ۰]
متغیر سیب = [۱۲، ۸]
عدد امتیاز = ۰
عدد رکورد = ۰
ذخیره رکورد

عنوان "🐍 مار نوا"
نمایش "امتیاز {امتیاز} · رکورد {رکورد}"
ردیف
  دکمه "➡️": اجرا برو [۱، ۰]
  دکمه "⬇️": اجرا برو [۰، ۱]
  دکمه "⬆️": اجرا برو [۰، -۱]
  دکمه "⬅️": اجرا برو [-۱، ۰]
پایان

کنش برو با جهت
  اگر جهت[۱] != -سو[۱] یا جهت[۲] != -سو[۲]: سو = جهت
پایان

وقتی کلید
  اگر کلید = "بالا": اجرا برو [۰، -۱]
  اگر کلید = "پایین": اجرا برو [۰، ۱]
  اگر کلید = "چپ": اجرا برو [-۱، ۰]
  اگر کلید = "راست": اجرا برو [۱، ۰]
پایان

هر ۰.۱۴ ثانیه
  متغیر سر = [مار[۱][۱] + سو[۱]، مار[۱][۲] + سو[۲]]
  اگر سر[۱] < ۱ یا سر[۱] > ۱۶ یا سر[۲] < ۱ یا سر[۲] > ۱۶ یا شامل(مار، سر)
    صدا ۱۲۰، ۴۰۰
    پیام "باختی! امتیاز: {امتیاز}"
    مار = [[۸، ۸]، [۷، ۸]، [۶، ۸]]
    سو = [۱، ۰]
    امتیاز = ۰
    برگرد
  پایان
  افزودن سر به اول مار
  اگر سر = سیب
    امتیاز += ۱
    رکورد = حداکثر(رکورد، امتیاز)
    سیب = [تصادفی(۱، ۱۶)، تصادفی(۱، ۱۶)]
    صدا ۹۸۸، ۶۰
  وگرنه
    حذف آخر از مار
  پایان
  پاک "#07110e"
  دایره سیب[۱] * ۲۰ - ۱۰، سیب[۲] * ۲۰ - ۱۰، ۸، "#ff5577"
  برای هر تکه در مار
    مستطیل تکه[۱] * ۲۰ - ۱۹، تکه[۲] * ۲۰ - ۱۹، ۱۸، ۱۸، "#67f5a5"
  پایان
پایان
