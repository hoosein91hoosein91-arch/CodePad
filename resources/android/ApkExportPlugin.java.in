package __APP_ID__;

import android.app.Activity;
import android.content.Intent;
import android.net.Uri;
import android.util.Base64;
import androidx.activity.result.ActivityResult;
import com.getcapacitor.JSObject;
import com.getcapacitor.Plugin;
import com.getcapacitor.PluginCall;
import com.getcapacitor.PluginMethod;
import com.getcapacitor.annotation.ActivityCallback;
import com.getcapacitor.annotation.CapacitorPlugin;
import java.io.File;
import java.io.FileInputStream;
import java.io.FileOutputStream;
import java.io.OutputStream;
import java.util.HashMap;
import java.util.UUID;

/** Chunked export to Android's document picker; no broad storage permission. */
@CapacitorPlugin(name = "ApkExport")
public class ApkExportPlugin extends Plugin {
    private final HashMap<String, File> sessions = new HashMap<>();
    private String savingId;
    private static final long LIMIT = 160L * 1024 * 1024;

    @PluginMethod public synchronized void begin(PluginCall call) {
        if (sessions.size() >= 3) { call.reject("یک خروجی دیگر در حال آماده‌سازی است."); return; }
        try {
            String id = UUID.randomUUID().toString();
            File file = File.createTempFile("codepad-export-", ".tmp", getContext().getCacheDir());
            sessions.put(id, file);
            JSObject result = new JSObject(); result.put("id", id); call.resolve(result);
        } catch (Exception error) { call.reject("فضای کافی برای آماده‌سازی خروجی نیست.", error); }
    }
    @PluginMethod public synchronized void append(PluginCall call) {
        File file = sessions.get(call.getString("id", ""));
        String encoded = call.getString("base64", "");
        if (file == null || call.getString("id", "").equals(savingId)) { call.reject("نشست خروجی معتبر نیست."); return; }
        if (encoded.length() > 1400000) { call.reject("قطعهٔ خروجی بیش از حد بزرگ است."); return; }
        try {
            byte[] bytes = Base64.decode(encoded, Base64.NO_WRAP);
            if (file.length() + bytes.length > LIMIT) throw new IllegalArgumentException("Export exceeds 160 MiB");
            try (FileOutputStream out = new FileOutputStream(file, true)) { out.write(bytes); }
            call.resolve();
        } catch (Exception error) { call.reject("نوشتن خروجی ناموفق بود.", error); }
    }
    @PluginMethod public synchronized void finish(PluginCall call) {
        String id = call.getString("id", "");
        File file = sessions.get(id);
        if (file == null || file.length() == 0) { call.reject("فایل خروجی خالی یا نامعتبر است."); return; }
        if (savingId != null) { call.reject("ابتدا ذخیرهٔ خروجی قبلی را تمام کن."); return; }
        String name = call.getString("name", "CodePad-export.apk").replaceAll("[\\\\/\\x00-\\x1F]", "_");
        Intent intent = new Intent(Intent.ACTION_CREATE_DOCUMENT);
        intent.addCategory(Intent.CATEGORY_OPENABLE);
        intent.setType(call.getString("mime", "application/octet-stream"));
        intent.putExtra(Intent.EXTRA_TITLE, name);
        savingId = id;
        getActivity().runOnUiThread(() -> {
            try { startActivityForResult(call, intent, "documentChosen"); }
            catch (Exception error) { synchronized (this) { savingId = null; } call.reject("پنجرهٔ ذخیره‌سازی باز نشد.", error); }
        });
    }
    @ActivityCallback private void documentChosen(PluginCall call, ActivityResult result) {
        final String id;
        final File file;
        synchronized (this) { id = savingId; savingId = null; file = sessions.remove(id); }
        if (call == null) { if (file != null) file.delete(); return; }
        Uri uri = result.getData() == null ? null : result.getData().getData();
        if (result.getResultCode() != Activity.RESULT_OK || uri == null) {
            if (file != null) file.delete();
            JSObject value = new JSObject(); value.put("saved", false); call.resolve(value); return;
        }
        if (file == null) { call.reject("خروجی پس از بسته‌شدن برنامه در دسترس نیست؛ دوباره بساز."); return; }
        new Thread(() -> {
            try (FileInputStream input = new FileInputStream(file);
                 OutputStream output = getContext().getContentResolver().openOutputStream(uri, "wt")) {
                if (output == null) throw new IllegalStateException("No output stream");
                byte[] buffer = new byte[65536]; int count;
                while ((count = input.read(buffer)) != -1) output.write(buffer, 0, count);
                output.flush();
                JSObject value = new JSObject(); value.put("saved", true); call.resolve(value);
            } catch (Exception error) { call.reject("ذخیرهٔ فایل ناموفق بود. فضای گوشی و محل ذخیره را بررسی کن.", error); }
            finally { file.delete(); }
        }, "CodePad-export-save").start();
    }
    @PluginMethod public synchronized void cancel(PluginCall call) {
        String id = call.getString("id", "");
        if (!id.equals(savingId)) { File file = sessions.remove(id); if (file != null) file.delete(); }
        call.resolve();
    }
    @Override protected synchronized void handleOnDestroy() {
        for (File file : sessions.values()) file.delete();
        sessions.clear(); savingId = null;
    }
}
